# CS2 Price Database - Environment Configuration
# Copy this file to .env and customize the values for your environment

# ============================================================================
# STEAM API CONFIGURATION
# ============================================================================

# Steam Market API endpoint
STEAM_MARKET_API_URL=https://steamcommunity.com/market/priceoverview/

# Rate limiting for Steam API (Conservative: 19 req/min, Steam allows ~40/min)
STEAM_API_RATE_LIMIT=19
STEAM_API_RATE_WINDOW=60

# Delay between individual requests (calculated: 60/19 = ~3.2 seconds)
STEAM_API_BURST_DELAY=3.2

# Backoff time when rate limited (seconds)
STEAM_API_RATE_LIMIT_BACKOFF=65

# ============================================================================
# PROXY CONFIGURATION
# ============================================================================

# Enable or disable proxy usage
USE_PROXIES=true

# GitHub source for fresh proxy list
PROXY_GITHUB_URL=https://raw.githubusercontent.com/TheLime1/Validity/refs/heads/main/data/http.txt

# Backup static proxy list (comma-separated)
PROXY_LIST=

# Backup proxy file path
PROXY_FILE=proxies.txt

# Proxy timeout settings
PROXY_TIMEOUT=10
PROXY_CONNECTION_TIMEOUT=15

# Proxy health management
PROXY_MAX_FAILURES=3
PROXY_HEALTH_CHECK_INTERVAL=300
PROXY_BACKOFF_TIME=300
ENABLE_PROXY_HEALTH_CHECK=false

# Proxy performance thresholds
PROXY_MIN_SUCCESS_RATE=0.8
PROXY_MAX_RESPONSE_TIME=30

# ============================================================================
# CONCURRENCY AND PERFORMANCE
# ============================================================================

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=50

# WebDriver pool size for fallback scraping
WEBDRIVER_POOL_SIZE=3

# Batch processing sizes
BATCH_SIZE_SKINS=20
BATCH_SIZE_VARIANTS=50
BATCH_SIZE_MISSING_ITEMS=50

# ============================================================================
# HTTP CLIENT CONFIGURATION
# ============================================================================

# Connection timeouts
HTTP_REQUEST_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=20

# Retry configuration
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=2.0
HTTP_RETRY_BACKOFF_MAX=60

# Connection pool settings
AIOHTTP_CONNECTOR_LIMIT=100
AIOHTTP_CONNECTOR_LIMIT_PER_HOST=30
TCP_CONNECTOR_TTL_DNS_CACHE=300

# Performance optimizations
ENABLE_HTTP_COMPRESSION=true
HTTP_CHUNK_SIZE=8192
ENABLE_TCP_NODELAY=true

# ============================================================================
# FALLBACK SCRAPER CONFIGURATION
# ============================================================================

# WebDriver timeouts
FALLBACK_SCRAPER_TIMEOUT=45
WEBDRIVER_PAGE_LOAD_TIMEOUT=30
WEBDRIVER_IMPLICIT_WAIT=10

# WebDriver options
WEBDRIVER_HEADLESS=true
WEBDRIVER_NO_SANDBOX=true
WEBDRIVER_DISABLE_DEV_SHM_USAGE=true

# Scraper delays and retries
SCRAPER_ELEMENT_WAIT_TIMEOUT=15
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_DELAY=5

# ============================================================================
# DATA FRESHNESS AND CACHING
# ============================================================================

# Price update interval (hours) - skip items updated within this time
PRICE_UPDATE_INTERVAL_HOURS=24

# Cache TTL settings (disabled by default as per request)
ENABLE_RESPONSE_CACHE=false
CACHE_TTL_MINUTES=0

# Database backup settings
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=7

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable detailed logging features
ENABLE_PERFORMANCE_LOGGING=true
LOG_NETWORK_TIMING=true
LOG_PROXY_STATISTICS=true
LOG_RATE_LIMIT_EVENTS=true
LOG_API_REQUESTS=true
LOG_FALLBACK_USAGE=true

# Performance logging intervals
PERFORMANCE_LOG_INTERVAL=60
PROXY_STATS_LOG_INTERVAL=300

# Log file paths (relative to project root)
LOG_DIR=logs
MAIN_LOG_FILE=price_collection.log
SUCCESS_ONLY_LOG_FILE=success_only_responses.log
API_RATE_LOG_FILE=api_rate_test.log
PERFORMANCE_LOG_FILE=performance.log
PROXY_STATS_LOG_FILE=proxy_statistics.log
SUMMARY_LOG_FILE=summary.txt

# ============================================================================
# ARTIFICIAL DELAYS AND TIMING
# ============================================================================

# Delays between operations (seconds)
DELAY_BETWEEN_REQUESTS=0.1
DELAY_BETWEEN_BATCHES=2.0
DELAY_BETWEEN_SKINS=0.5

# Fallback scraper delays
DELAY_BEFORE_SCRAPING=1.0
DELAY_AFTER_SCRAPING=0.5
DELAY_BETWEEN_WEBDRIVER_ACTIONS=0.3

# Database operation delays
DELAY_BEFORE_SAVE=0.1
DELAY_AFTER_SAVE=0.2

# ============================================================================
# ERROR HANDLING AND RECOVERY
# ============================================================================

# Automatic recovery settings
ENABLE_AUTOMATIC_RETRY=true
NETWORK_ERROR_RETRY_DELAY=5
DNS_ERROR_RETRY_DELAY=10
PROXY_ERROR_SWITCH_IMMEDIATELY=true
FALLBACK_TO_DIRECT_ON_ALL_PROXY_FAIL=true

# Circuit breaker settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=300
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3

# ============================================================================
# MONITORING AND ALERTING
# ============================================================================

# Performance monitoring thresholds
MAX_ACCEPTABLE_RESPONSE_TIME=10.0
MIN_ACCEPTABLE_SUCCESS_RATE=0.9
MAX_ACCEPTABLE_ERROR_RATE=0.1

# Rate limiting monitoring
RATE_LIMIT_WARNING_THRESHOLD=0.8
RATE_LIMIT_CRITICAL_THRESHOLD=0.95

# Resource usage monitoring
MAX_MEMORY_USAGE_MB=1000
MAX_CPU_USAGE_PERCENT=80

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database file paths
DATABASE_FILE=data/skins_database.json
CHECKPOINT_FILE=price_collection_checkpoint.json

# Backup configuration
BACKUP_DIR=backups
MAX_BACKUP_FILES=10

# Data validation settings
ENABLE_STRICT_VALIDATION=true
VALIDATE_PRICE_RANGES=true
MIN_VALID_PRICE=0.01
MAX_VALID_PRICE=50000.0

# ============================================================================
# CLEANUP AND MAINTENANCE
# ============================================================================

# Automatic cleanup settings
ENABLE_AUTO_CLEANUP=true
CLEANUP_INVALID_VARIANTS=true
CLEANUP_OLD_PRICES=false
CLEANUP_EMPTY_VARIANTS=true

# Statistics generation
ENABLE_AUTO_STATISTICS=true
GENERATE_DETAILED_STATS=true

# ============================================================================
# DEVELOPMENT AND DEBUGGING
# ============================================================================

# Debug features (set to false in production)
DEBUG_MODE=false
ENABLE_API_MOCKING=false
ENABLE_DETAILED_TRACING=false

# Test mode settings
TEST_MODE=false
TEST_LIMIT_SKINS=0
TEST_SKIP_FALLBACK=false

# Performance profiling
ENABLE_PROFILING=false
PROFILE_OUTPUT_FILE=performance_profile.log

# ============================================================================
# SECURITY AND PRIVACY
# ============================================================================

# User agent for HTTP requests
USER_AGENT=CS2-TradeUp-Scanner/1.0

# Request headers customization
CUSTOM_HEADERS={}

# Proxy authentication (if needed)
PROXY_USERNAME=
PROXY_PASSWORD=

# Rate limiting respect
RESPECT_ROBOTS_TXT=true
HONOR_RATE_LIMIT_HEADERS=true

# ============================================================================
# EXPERIMENTAL FEATURES
# ============================================================================

# Feature flags for experimental functionality
ENABLE_DISTRIBUTED_MODE=false
ENABLE_REDIS_QUEUE=false
ENABLE_WEBHOOK_NOTIFICATIONS=false

# Experimental performance optimizations
ENABLE_REQUEST_PIPELINING=false
ENABLE_CONNECTION_MULTIPLEXING=false
ENABLE_ASYNC_DATABASE_WRITES=false