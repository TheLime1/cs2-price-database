# CS2 Price Database - Environment Configuration
# Copy this file to .env and customize the values for your environment

# ============================================================================
# STEAM API CONFIGURATION
# ============================================================================

# Steam Market API endpoint
STEAM_MARKET_API_URL=https://steamcommunity.com/market/priceoverview/

# Rate limiting for Steam API (Conservative: 19 req/min, Steam allows ~40/min)
STEAM_API_RATE_LIMIT=19
STEAM_API_RATE_WINDOW=60

# Backoff time when rate limited (seconds)
STEAM_API_RATE_LIMIT_BACKOFF=65

# ============================================================================
# PROXY CONFIGURATION
# ============================================================================

# Enable or disable proxy usage
USE_PROXIES=false

# GitHub source for fresh proxy list
PROXY_GITHUB_URL=https://raw.githubusercontent.com/TheLime1/Validity/refs/heads/main/data/http.txt

# Backup static proxy list (comma-separated)
PROXY_LIST=

# Backup proxy file path
PROXY_FILE=proxies.txt

# Enable direct IP usage when all proxies fail
USE_DIRECT_IP_ON_PROXY_FAIL=true

# Enable proxy health checks
ENABLE_PROXY_HEALTH_CHECK=false

# Proxy health check URL
PROXY_HEALTH_CHECK_URL=https://httpbin.org/ip

# ============================================================================
# CONCURRENCY AND PERFORMANCE
# ============================================================================

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=50

# WebDriver pool size for fallback scraping
WEBDRIVER_POOL_SIZE=3

# Batch processing sizes
BATCH_SIZE_SKINS=20
BATCH_SIZE_VARIANTS=50
BATCH_SIZE_MISSING_ITEMS=50

# ============================================================================
# DATA FRESHNESS
# ============================================================================

# Price update interval (hours) - skip items updated within this time
PRICE_UPDATE_INTERVAL_HOURS=24

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file paths (relative to project root)
LOG_DIR=logs
MAIN_LOG_FILE=price_collection.log
SUCCESS_ONLY_LOG_FILE=success_only_responses.log
API_RATE_LOG_FILE=api_rate_test.log
SUMMARY_LOG_FILE=summary.txt

# ============================================================================
# TIMING AND DELAYS
# ============================================================================

# Delays between operations (seconds)
DELAY_BETWEEN_REQUESTS=0.1
DELAY_BETWEEN_BATCHES=2.0
DELAY_BETWEEN_SKINS=0.5

# Database operation delays
DELAY_BEFORE_SAVE=0.1
DELAY_AFTER_SAVE=0.2

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database file paths
DATABASE_FILE=data/skins_database.json
CHECKPOINT_FILE=price_collection_checkpoint.json

# ============================================================================
# DEVELOPMENT AND DEBUGGING
# ============================================================================

# Debug features (set to false in production)
DEBUG_MODE=false