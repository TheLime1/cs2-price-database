# CS2 Price Database V3.0 - Environment Configuration
# Copy this file to .env and customize the values for your environment

# ============================================================================
# WEBDRIVER CONFIGURATION (V3.0)
# ============================================================================

# WebDriver pool size for concurrent scraping
WEBDRIVER_POOL_SIZE=3
WORKER_COUNT=3

# WebDriver timeouts
WEBDRIVER_PAGE_LOAD_TIMEOUT=30
WEBDRIVER_IMPLICIT_WAIT=10

# WebDriver options
WEBDRIVER_HEADLESS=true
HEADLESS_MODE=true
WEBDRIVER_NO_SANDBOX=true
WEBDRIVER_DISABLE_DEV_SHM_USAGE=true

# Scraper delays and retries
SCRAPER_ELEMENT_WAIT_TIMEOUT=15
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_DELAY=5

# ============================================================================
# RATE LIMITING (V3.0)
# ============================================================================

# WebDriver rate limiting (1-3 requests per second per instance)
WEBDRIVER_MIN_RPS=1.0
WEBDRIVER_MAX_RPS=3.0

# Delay between requests (randomized for natural behavior)
DELAY_BETWEEN_REQUESTS=0.2
DELAY_BETWEEN_BATCHES=2.0
DELAY_BETWEEN_SKINS=0.5

# ============================================================================
# DATA SOURCES (V3.0)
# ============================================================================

# csgodatabase.com scraping
CSGODATABASE_BASE_URL=https://www.csgodatabase.com

# csgoskins.gg wear range validation
CSGOSKINS_BASE_URL=https://csgoskins.gg

# ============================================================================
# DATA FRESHNESS AND CACHING
# ============================================================================

# Price update interval (hours)
PRICE_UPDATE_INTERVAL_HOURS=24

# Database backup settings
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=7

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Checkpoint settings
CHECKPOINT_INTERVAL=10
